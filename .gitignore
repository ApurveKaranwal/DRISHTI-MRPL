# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Operating System Files
.DS_Store
*DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
dihhhhhhh/

# Output generated deliverables and session artifacts (preserve structure via .gitkeep)
outputs/reports/*
!outputs/reports/.gitkeep
outputs/sandbox/*
!outputs/sandbox/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Local Database Binary Caches (recreated automatically from CSV/PDF data)
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
*.tmp

# Test and Runtime artifacts
.pytest_cache/
model_discovery_state.json

# Output root-level artifacts (preserve subdirectory structure)
outputs/*
!outputs/.gitkeep
!outputs/reports/
!outputs/sandbox/
